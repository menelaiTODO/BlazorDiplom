@using BlazorDiplom.Infrastructure.Enums
@using BlazorDiplom.ViewModels
@using BlazorDiplom.ViewModels.MOLAP
@using FuzzyDataDbCore.Models
@inherits FuzzyConstructorComponent

<div>
    <div>
        <h5>Выберите тип лингвистической переменной:</h5>
    <div>
            <DxComboBox
                Data="LinguisticVariableType" 
                Value="LinguisticVariableBindedValue"
                ValueFieldName="Key"
                        SelectedItemChanged="(KeyValuePair<int, string> item) => OnLinguisticChanged(item)"
                EditFormat="{0}"
                        DisplayFormat="{0}">
            <Columns>
                <DxListEditorColumn Caption="Наименование" FieldName="Value" />
            </Columns>
        </DxComboBox>
    </div>
    </div>
    @if (LinguisticVariableBindedValue == (int)LinguisticVariableTypeEnum.SingletoneLinguisticVariable)
    {
    <div>
    <div>
        <fieldset id="fuzzyFuncRadio">
        @if (FuzzyFunctionDt is not null)
        {
            <h5>Выберите тип функции принадлежности:</h5>

            foreach (var item in FuzzyFunctionDt)
            {
                <div>
                  <input name="fuzzyFuncRadio" value="@item.Id" type="radio" onchange="@SelectedFuzzyFunctionChanged" />
                  <img width="200" height="150" src="@item.ImgSrc" />
                  <p>@item.Description</p>
                </div>
            }
        }
        </fieldset>
    </div>
    <div>
    @if (SelectedFuzzyFunctionData != null)
    {
            <div>
              <h5>Введите минимальный порог соответствия элементов лингвистической переменной:</h5>
            </div>
           
            <div>
              <InputNumber @bind-Value="@SingletoneLinguisticVariableData.MinIndex" />
            </div>

            <div>
              <h5>Введите точки для построения функции принадлежности:</h5>
            </div>

            var index = 0;
            foreach (var item in SelectedFuzzyFunctionData.YValues)
            {
                var ii = index;
                <div>
                    <p>Точка #@(index+1). Значение по оси ординат = @(item) </p>
                    <InputNumber @bind-Value="@SingletoneLinguisticVariableData.Points[ii]" />
                </div>

                index += 1;
            }

            @if (SingletoneLinguisticVariableData.Points.Any(item => item != 0))
            {
                <DxChart Data="@SingletoneLinguisticVariableData.PointsForChart">
                    <DxChartLineSeries Name="Функция принадлежности"
                                       ArgumentField="((double X, double Y) item) => item.X"
                                       ValueField="((double X, double Y) item) => item.Y"
                                       DashStyle="ChartDashStyle.Dash">
                    </DxChartLineSeries>
                </DxChart>
            }

            <div>
              <h5>Выберите меру к которой относится лингвистическая переменная:</h5>
            </div>
            <div>
              <DxComboBox ValueFieldName="AttrName" Data="@OlapAttrs" @bind-Value="@SingletoneLinguisticVariableData.MOLAPItemName" EditFormat="{0}" DisplayFormat="{0}">
                 <Columns>
                  <DxListEditorColumn Caption="Наименование" FieldName="AttrName" />
                </Columns>
              </DxComboBox>
            </div>
             <div>
              <h5>Введите наименование лингвистической переменной:</h5>
            </div>
            <div>
              <InputText @bind-Value="@SingletoneLinguisticVariableData.Name" />
            </div>

            <DxButton RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained"  Text="Сохранить" Click="@SaveSingleVariableChanges"></DxButton>
        }
    </div>
        </div>
    }
    else if (LinguisticVariableBindedValue == (int)LinguisticVariableTypeEnum.MultiplyLunguisticVariable)
    {
     <div>
            <div>
              <h5>Выберите меру к которой относится составная лингвистическая переменная:</h5>
            </div>
            <div>
              <DxComboBox 
                  ValueFieldName="AttrName" 
                  Data="@OlapAttrs" 
                  @bind-Value="@MultiplyLinguisticVariableData.MeasureName" 
                  EditFormat="{0}" 
                  DisplayFormat="{0}"
                  SelectedItemChanged = "(OlapAttr item) => OnMultipyVariableOlapAttrChanged(item)">
                <Columns>
                  <DxListEditorColumn Caption="Наименование" FieldName="AttrName" />
                </Columns>

              </DxComboBox>
            </div>

            @if (!string.IsNullOrEmpty(MultiplyLinguisticVariableData.MeasureName))
            {
                <div>
                    <h5>Выберите одиночные функции принадлежности:</h5>
                </div>
                <div>
                    <DxDataGrid SelectionMode="DataGridSelectionMode.MultipleSelectedDataRows" MultipleSelectedDataRowsChanged = "(IEnumerable<CustomLinguisticVariable> items) => MultiplyLinguisticVariableData.SingletoneLinguisticVariables = items" Data="@GridDataForMultiplyVariable">
                        <DxDataGridColumn Field="@nameof(CustomLinguisticVariable.Name)" Caption="Наименование"></DxDataGridColumn>
                        <DxDataGridColumn Field="@nameof(CustomLinguisticVariable.MeasureName)" Caption="Мера"></DxDataGridColumn>
                        <DxDataGridColumn Field="@nameof(CustomLinguisticVariable.CreatedDate)" Caption="Дата создания"></DxDataGridColumn>
                    </DxDataGrid>
                </div>
                <div>
                    <h5>Введите наименование составной лингвистической переменной:</h5>
                </div>

                <div>
                    <InputText @bind-Value="@MultiplyLinguisticVariableData.Name" />
               </div>

               <DxButton RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained"  Text="Сохранить" Click="@SaveMultiplyVariableChanges"></DxButton>
            }
     </div>
    }
</div>
